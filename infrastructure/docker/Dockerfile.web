FROM node:20-alpine AS base

RUN corepack enable && corepack prepare pnpm@12.16.1 --activate

WORKDIR /app

COPY package.json pnpm-workspace.yaml .npmrc ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/web/package.json ./apps/web/

COPY packages/shared ./packages/shared
COPY apps/web ./apps/web

RUN pnpm install --frozen-lockfile=false

RUN pnpm --filter @pdf-to-audio/shared build
RUN cd apps/web && pnpm dlx prisma generate

RUN pnpm --filter web build

FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

COPY --from=base /app/apps/web/public ./apps/web/public
COPY --from=base /app/apps/web/.next ./apps/web/.next
COPY --from=base /app/node_modules ./node_modules
COPY --from=base /app/apps/web/node_modules ./apps/web/node_modules
COPY --from=base /app/apps/web/package.json ./apps/web/package.json
COPY --from=base /app/apps/web/prisma ./apps/web/prisma

EXPOSE 3000

CMD ["node", "./node_modules/next/dist/bin/next", "start", "apps/web", "-p", "3000"]

