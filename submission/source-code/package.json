{
  "name": "pdf-to-audio-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Commercial PDF-to-Audio Conversion SaaS Platform",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:processor": "cd services/processor && uvicorn app.main:app --reload --port 8000",
    "dev:worker": "cd services/processor && celery -A app.workers.celery_app worker --loglevel=info -P solo",
    "build:web": "pnpm --filter web build",
    "test:web": "pnpm --filter web test",
    "test:processor": "cd services/processor && pytest",
    "test": "pnpm test:web && pnpm test:processor",
    "lint": "pnpm --filter web lint"
  },
  "keywords": [
    "pdf",
    "audio",
    "tts",
    "saas",
    "conversion",
    "ocr",
    "celery",
    "fastapi",
    "nextjs"
  ],
  "author": "Antigravity Engineering",
  "license": "Commercial"
}
