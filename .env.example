# ==============================================================================
# Commercial PDF-to-Audio SaaS Environment Configuration Template
# Placeholders only. Copy to .env and configure secrets.
# ==============================================================================

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pdf_to_audio?schema=public"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_secure_password_replace_in_prod"
POSTGRES_DB="pdf_to_audio"
POSTGRES_PORT=5432

# Redis & Celery Configuration
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# Web Application (Next.js & Auth.js)
NEXTAUTH_SECRET="generate_a_random_32_character_secret_key_here"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Service-to-Service Internal Authentication
PROCESSOR_API_URL="http://localhost:8000"
INTERNAL_API_KEY="generate_secure_random_internal_api_token_here"

# Storage Configuration
STORAGE_ROOT="./storage"
STORAGE_PROVIDER="local" # Options: local, s3
# S3 / MinIO Configuration (Optional for cloud storage)
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET_NAME="pdf-to-audio-documents"
S3_REGION="us-east-1"

# Text-to-Speech Engine Configuration
TTS_PROVIDER="edge" # Options: edge (built-in neural), azure, mock
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""

# System Limits & Quotas
MAX_UPLOAD_SIZE_MB=50
MAX_PAGES_LIMIT=500
MAX_CONCURRENT_JOBS_PER_USER=3
DEFAULT_CHUNK_SIZE_CHARS=1000
OCR_RESOLUTION_DPI=300

# OCR Configuration
TESSERACT_PATH="" # Optional custom path e.g. /usr/bin/tesseract or C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_DEFAULT_LANGUAGES="eng,spa,fra,deu"

# Monitoring and Debugging
LOG_LEVEL="INFO"
NODE_ENV="development"

